[Unit]
Description=InkyPi App
After=network-online.target
Wants=network-online.target

[Service]
User=root
RuntimeDirectory=inkypi
WorkingDirectory=/run/inkypi
ExecStart=/usr/local/bin/inkypi run
Restart=on-failure
RestartSec=60
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
# Sized so the Home Assistant plugin's headless Chromium can render the full HA
# frontend (needs ~300-350MB and multiple cores). The previous 40%/200M starved it,
# producing blank captures. earlyoom + zram (installed by install.sh) guard the OS.
CPUQuota=350%
MemoryMax=384M

[Install]
WantedBy=multi-user.target